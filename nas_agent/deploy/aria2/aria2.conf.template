# Generated by install_nas.sh. RPC is bound to localhost only; the secret lives in this 0600 file.
enable-rpc=true
rpc-listen-all=false
rpc-listen-port=@PORT@
rpc-secret=@SECRET@
# resume + robustness for multi-hundred-GB transfers
continue=true
max-tries=10
retry-wait=30
connect-timeout=30
timeout=120
max-concurrent-downloads=4
max-connection-per-server=8
split=8
min-split-size=32M
file-allocation=none
disk-cache=64M
auto-file-renaming=false
allow-overwrite=false
check-certificate=true
# keep results so nas-mcp can report on large jobs; survive container restarts
max-download-result=100000
save-session=/state/aria2.session
input-file=/state/aria2.session
save-session-interval=30
log=/state/aria2.log
log-level=notice
console-log-level=warn
